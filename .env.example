VITE_ENABLE_RECAPTCHA=false
VITE_RECAPTCHA_SITE_KEY=
VITE_API_URL=http://localhost:4000/graphql
VITE_API_WS=ws://localhost:4000/graphql

# Google Sign-In
# Use the same OAuth Web Client ID on frontend and backend.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Facebook Login
# App ID is public and must match on frontend/backend.
VITE_FACEBOOK_APP_ID=
FACEBOOK_APP_ID=
# App Secret is server-side only. Never create a VITE_FACEBOOK_APP_SECRET variable.
FACEBOOK_APP_SECRET=
# Keep both values aligned with a Graph API version supported by your Meta app.
VITE_FACEBOOK_GRAPH_API_VERSION=v23.0
FACEBOOK_GRAPH_API_VERSION=v23.0

# Password recovery email
# Public URL where users open /login?resetToken=...
PUBLIC_WEB_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_MS=60000
# Gmail can use SMTP_USER + an App Password. Production may use a dedicated SMTP host.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional if maps are enabled
VITE_MAPBOX_TOKEN=your_mapbox_token

# -------------------------------
# Backend payment platform setup
# -------------------------------
# These values belong to the COHAN platform owner. Restaurant customers never enter them.
# Production must use public HTTPS URLs. Do not use localhost for provider callbacks.
PAYMENT_PUBLIC_BASE_URL=http://localhost:4000
PAYMENT_WEB_RETURN_URL=http://localhost:5173
# MoMo recommends a timeout of at least 30 seconds for payment API calls.
PAYMENT_PROVIDER_TIMEOUT_MS=30000
PAYMENT_SESSION_TTL_MINUTES=10

# Keep credentials server-side. Never expose them as VITE_* variables.
# Required in production when restaurant managers save merchant credentials.
# Generate a 32-byte random value and keep it stable; changing it prevents decrypting saved credentials.
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=

# Production gateways are blocked outside NODE_ENV=production by default.
# Enable only for an intentional production-gateway test from a non-production runtime.
PAYMENT_ALLOW_PRODUCTION_IN_DEVELOPMENT=false

# Optional platform fallback merchant account. Restaurant-owned credentials take priority.
# These modes describe the real environment of the platform credential sets below.
MOMO_PLATFORM_MODE=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT_SANDBOX=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_ENDPOINT_PRODUCTION=https://payment.momo.vn/v2/gateway/api/create
MOMO_REQUEST_TYPE=captureWallet

VNPAY_PLATFORM_MODE=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL_SANDBOX=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_URL_PRODUCTION=https://pay.vnpay.vn/vpcpay.html
# Platform-owned payment experience. Restaurant customers do not enter this field.
# VNPAYQR = QR, VNBANK = domestic bank/card, INTCARD = international card, blank = VNPAY selector.
VNPAY_BANK_CODE=VNPAYQR

# -------------------------------
# Backend AI Chatbot (server-side)
# -------------------------------
# NOTE: Do not expose these as VITE_* variables in frontend builds.
# AI_PROVIDER selects the backend chatbot engine: "gemini" or "local".
# The project default is Gemini with local Qwen3 fallback.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=local

# GEMINI_API_KEY enables Gemini provider-backed answers.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
AI_CHATBOT_MODEL=gemini-3.5-flash
# Quality-first interactive limits: give Gemini enough time before falling back.
AI_CHATBOT_GEMINI_TIMEOUT_MS=30000
AI_CHATBOT_LOCAL_TIMEOUT_MS=15000
AI_CHATBOT_EMBEDDING_TIMEOUT_MS=8000

# Local AI via the backend-only Ollama endpoint.
LOCAL_AI_ENABLED=true
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_CHAT_PATH=/api/chat
LOCAL_AI_EMBEDDING_PATH=/api/embeddings
LOCAL_AI_CHAT_MODEL=qwen3:8b
LOCAL_AI_EMBEDDING_MODEL=bge-m3
LOCAL_AI_TIMEOUT_MS=30000
AI_EMBEDDING_PROVIDER=local
AI_EMBEDDING_CACHE_TTL_MS=86400000

# -------------------------------
# Backend GraphQL Query Limits
# -------------------------------
GRAPHQL_MAX_DEPTH=12
GRAPHQL_MAX_FIELD_COUNT=500
ALLOW_UNSAFE_GRAPHQL_LIMITS=false

# Frontend account verification policy (must match backend ACCOUNT_ACTIVATION_REQUIRE)
VITE_ACCOUNT_ACTIVATION_REQUIRE=email

# -------------------------------
# Review AI Insights (optional)
# -------------------------------
# When false/missing, review analytics uses deterministic heuristic summary.
REVIEW_AI_INSIGHTS_ENABLED=false
# Enable Gemini review insight with AI_PROVIDER=gemini + GEMINI_API_KEY server-side.
# REVIEW_AI_INSIGHT_MODEL=gemini-3.5-flash
# REVIEW_AI_INSIGHT_TIMEOUT_MS=8000
