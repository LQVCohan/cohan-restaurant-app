VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
VITE_API_URL=http://localhost:4000/graphql
VITE_API_WS=ws://localhost:4000/graphql
# Optional if maps are enabled
VITE_MAPBOX_TOKEN=your_mapbox_token

# -------------------------------
# Backend AI Chatbot (server-side)
# -------------------------------
# NOTE: Do not expose these as VITE_* variables in frontend builds.
# OPENAI_API_KEY enables provider-backed answers. Without it, chatbot uses fallback behavior.
OPENAI_API_KEY=your_openai_api_key

# Optional chatbot model override. Service resolves model as:
# AI_CHATBOT_MODEL -> AI_MODEL -> default "gpt-5"
AI_CHATBOT_MODEL=gpt-5
# AI_MODEL=gpt-5
