VITE_ENABLE_RECAPTCHA=false
VITE_RECAPTCHA_SITE_KEY=
VITE_API_URL=http://localhost:4000/graphql
VITE_API_WS=ws://localhost:4000/graphql

# Google Sign-In
# Use the same OAuth Web Client ID on frontend and backend.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Optional if maps are enabled
VITE_MAPBOX_TOKEN=your_mapbox_token

# -------------------------------
# Backend AI Chatbot (server-side)
# -------------------------------
# NOTE: Do not expose these as VITE_* variables in frontend builds.
# AI_PROVIDER selects the backend chatbot engine: "gemini" or "local".
# The project default is Gemini with local Qwen3 fallback.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=local

# GEMINI_API_KEY enables Gemini provider-backed answers.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
AI_CHATBOT_MODEL=gemini-3.5-flash

# Local AI via the backend-only Ollama endpoint.
LOCAL_AI_ENABLED=true
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_CHAT_PATH=/api/chat
LOCAL_AI_EMBEDDING_PATH=/api/embeddings
LOCAL_AI_CHAT_MODEL=qwen3:8b
LOCAL_AI_EMBEDDING_MODEL=bge-m3
LOCAL_AI_TIMEOUT_MS=30000
AI_EMBEDDING_PROVIDER=local
AI_EMBEDDING_CACHE_TTL_MS=86400000

# -------------------------------
# Backend GraphQL Query Limits
# -------------------------------
GRAPHQL_MAX_DEPTH=12
GRAPHQL_MAX_FIELD_COUNT=500
ALLOW_UNSAFE_GRAPHQL_LIMITS=false

# Frontend account verification policy (must match backend ACCOUNT_ACTIVATION_REQUIRE)
VITE_ACCOUNT_ACTIVATION_REQUIRE=email

# -------------------------------
# Review AI Insights (optional)
# -------------------------------
# When false/missing, review analytics uses deterministic heuristic summary.
REVIEW_AI_INSIGHTS_ENABLED=false
# Enable Gemini review insight with AI_PROVIDER=gemini + GEMINI_API_KEY server-side.
# REVIEW_AI_INSIGHT_MODEL=gemini-3.5-flash
# REVIEW_AI_INSIGHT_TIMEOUT_MS=8000
