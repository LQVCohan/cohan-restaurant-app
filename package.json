{
  "name": "cohan-restaurant-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "node scripts/start-mobile-dev.mjs",
    "build": "vite build",
    "lint": "eslint src/config/**/*.{js,jsx} eslint.config.js",
    "preview": "vite preview",
    "preview:mobile": "vite preview --host 0.0.0.0",
    "test": "npm run test:unit && npm run test:api",
    "test:menu-rbac": "vitest run src/utils/frontendRoleAccess.test.js",
    "env:local": "node scripts/setup-local-env.mjs",
    "test:frontend": "vitest run",
    "test:customer-manager": "vitest run src/components/Dashboard_Manager/Customer/CustomerList.test.jsx",
    "test:backend": "npm --prefix cohan-restaurant-backend test",
    "check:graphql:schema": "node cohan-restaurant-backend/scripts/validateGraphqlSchema.mjs",
    "check:graphql:operations": "node scripts/validateGraphqlOperations.mjs",
    "check:graphql": "npm run check:graphql:schema && npm run check:graphql:operations",
    "check:demo": "npm run check:graphql && npm --prefix cohan-restaurant-backend test -- tests/resolvers/user-privacy.test.js tests/security/graphql-limits.test.js && vitest run src/__tests__/graphql-schema-validation.test.js",
    "test:performance": "vitest run src/components/Dashboard_Manager/Staff/components/Performance/StaffPerformancePage.test.jsx && vitest run --config vitest.backend.config.js cohan-restaurant-backend/tests/services/staff-performance-core-formula.service.test.js cohan-restaurant-backend/tests/services/performance-incident.service.test.js cohan-restaurant-backend/tests/services/performance-appeal.service.test.js && node --check cohan-restaurant-backend/scripts/verifyStaffPerformanceDemoRegression.js",
    "check:conflicts": "node scripts/check-conflict-markers.mjs",
    "test:unit": "vitest run src/utils src/hooks src/context src/routes src/lib src/__tests__",
    "test:api": "npm --prefix cohan-restaurant-backend test",
    "test:component": "vitest run src/components",
    "test:table-ar": "vitest run src/utils/arMobileTestReport.test.js src/components/Dashboard_Manager/Table/Table3DActionBarV2.test.jsx src/components/Dashboard_Manager/Table/Table3DSimulatorModalV2.test.jsx src/components/Dashboard_Manager/Table/ArTablePlacementModal.test.jsx && playwright test tests/e2e/table-ar-mobile.spec.js",
    "test:table-ar:unit": "vitest run src/utils/arMobileTestReport.test.js src/components/Dashboard_Manager/Table/Table3DActionBarV2.test.jsx src/components/Dashboard_Manager/Table/Table3DSimulatorModalV2.test.jsx src/components/Dashboard_Manager/Table/ArTablePlacementModal.test.jsx",
    "test:table-ar:e2e": "playwright test tests/e2e/table-ar-mobile.spec.js",
    "test:e2e": "playwright test tests/e2e",
    "test:smoke": "playwright test tests/e2e/smoke",
    "test:p1": "playwright test tests/e2e/p1",
    "test:ci": "npm run check:conflicts && npm run lint && npm run build && npm run check:graphql && npm run test:unit && npm run test:component && npm run test:api && npm run test:smoke",
    "seed:test": "node scripts/seed-test-data.mjs",
    "reset:test-db": "node scripts/seed-test-data.mjs --reset-plan",
    "check:staff-theme": "node scripts/check-staff-theme-colors.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@apollo/client": "^3.14.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.6.0",
    "antd": "^6.2.3",
    "axios": "^1.10.0",
    "chart.js": "^4.5.0",
    "dataloader": "^2.2.3",
    "date-fns": "^4.1.0",
    "fastify": "^5.6.0",
    "fastify-cors": "^6.0.3",
    "fastify-helmet": "^7.0.1",
    "framer-motion": "^12.38.0",
    "graphql": "^16.11.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "mapbox-gl": "^3.17.0",
    "maplibre-gl": "^5.14.0",
    "mercurius": "^16.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.1.0",
    "react-pageflip": "^2.0.3",
    "react-router": "^7.17.0",
    "react-router-dom": "^7.6.3",
    "recharts": "^3.6.0",
    "sass": "^1.89.2",
    "socket.io-client": "^4.8.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "fast-uri": "3.1.2"
  }
}
