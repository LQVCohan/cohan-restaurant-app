# ============================
# 🌍 Environment & App Config
# ============================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# ============================
# 🔒 Authentication
# ============================
JWT_SECRET=replace-with-strong-random-32-plus-char-secret
JWT_ISSUER=foodhub-system
# Legacy fallback only; prefer ACCESS_TOKEN_EXPIRES_IN.
JWT_EXPIRES_IN=15m
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SAMESITE=lax
ALLOW_AUTH_COOKIE_NO_ORIGIN=false
TABLE_ACCESS_TOKEN_SECRET=your-table-access-token-secret
TABLE_ACCESS_TOKEN_EXPIRES_IN=8h

# ============================
# 🍃 MongoDB Connection
# ============================
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority
MONGO_DB=RestaurantDB

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000

RL_GLOBAL_MAX=200
RL_GLOBAL_WINDOW=1 minute
RL_AUTH_MAX=12
RL_AUTH_WINDOW=1 minute
RL_AUTH_REFRESH_MAX=30
RL_AUTH_REFRESH_WINDOW=1 minute
RL_AUTH_LOGOUT_MAX=60
RL_AUTH_LOGOUT_WINDOW=1 minute
RL_BAN=0

# GraphQL query DoS protections. Production values above depth 25 or field count 2000
# require ALLOW_UNSAFE_GRAPHQL_LIMITS=true.
GRAPHQL_MAX_DEPTH=12
GRAPHQL_MAX_FIELD_COUNT=500
ALLOW_UNSAFE_GRAPHQL_LIMITS=false

ENABLE_RECAPTCHA=true
RECAPTCHA_SECRET=replace-with-recaptcha-secret
# In production, do not disable reCAPTCHA unless ALLOW_DISABLE_RECAPTCHA_IN_PRODUCTION=true.
ALLOW_DISABLE_RECAPTCHA_IN_PRODUCTION=false
ENABLE_EMAIL_VERIFICATION=true
APP_PUBLIC_URL=http://localhost:5173
ENABLE_PASSWORD_POLICY=true
CSP_ALLOW_UNSAFE_INLINE_STYLE=false

# ============================
# 🤖 AI Chatbot
# ============================
# AI_PROVIDER selects the chatbot engine used by backend responses: "gemini" or "local".
# The project default is Gemini, with local Qwen3 as fallback.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=local
# GEMINI_API_KEY enables Gemini provider-backed answers.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
AI_CHATBOT_MODEL=gemini-3.5-flash

# Optional local AI via the backend-only Ollama endpoint.
# Never expose LOCAL_AI_BASE_URL to frontend clients.
LOCAL_AI_ENABLED=true
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_CHAT_PATH=/api/chat
LOCAL_AI_EMBEDDING_PATH=/api/embeddings
LOCAL_AI_CHAT_MODEL=qwen3:8b
LOCAL_AI_EMBEDDING_MODEL=bge-m3
LOCAL_AI_TIMEOUT_MS=30000
AI_EMBEDDING_PROVIDER=local
AI_EMBEDDING_CACHE_TTL_MS=86400000

# Account verification
APP_PUBLIC_URL=http://localhost:5173
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PHONE_VERIFICATION=false
ENABLE_SMS_VERIFICATION=false
VERIFICATION_TOKEN_TTL_HOURS=24
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
ACCOUNT_ACTIVATION_REQUIRE=email
DEFAULT_VERIFICATION_CHANNELS=email
STAFF_ACCOUNT_REQUIRES_VERIFICATION=false
# Optional pepper used for SHA-256 verification token hashes. Keep stable after enabling.
VERIFICATION_TOKEN_PEPPER=

# Contact change OTP
CONTACT_CHANGE_OTP_TTL_MINUTES=10
CONTACT_CHANGE_OTP_COOLDOWN_SECONDS=60
CONTACT_CHANGE_OTP_MAX_ATTEMPTS=5
# Currently fixed to 6 digits for UI consistency.
CONTACT_CHANGE_OTP_LENGTH=6

# SMTP email provider. Dev/test can run without these; delivery returns skipped/not_configured.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_FROM=

# SMS provider: mock (dev), http (generic webhook). twilio is documented as a placeholder
# and currently returns NOT_CONFIGURED; use http for production SMS gateways until a Twilio adapter is implemented.
SMS_PROVIDER=mock
SMS_FROM=
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
