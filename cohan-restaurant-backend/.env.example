NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=7d
JWT_ISSUER=cohan-restaurant
MONGO_URI=mongodb://localhost:27017
MONGO_DB=RestaurantDB
CORS_ORIGINS=http://localhost:5173
RL_GLOBAL_MAX=200
RL_GLOBAL_WINDOW=1 minute
RL_AUTH_MAX=20
RL_AUTH_WINDOW=15 minute
RL_BAN=15 minute
GRAPHQL_GRAPHIQL=true
GRAPHQL_INTROSPECTION=true
ENABLE_RECAPTCHA=false
RECAPTCHA_SECRET=replace_with_recaptcha_secret
ENABLE_EMAIL_VERIFICATION=false
APP_PUBLIC_URL=http://localhost:5173
ENABLE_PASSWORD_POLICY=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=replace_with_smtp_app_password
MAIL_FROM=no-reply@example.com
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp
UPLOAD_TO_WEBP=true
PUBLIC_BASE_URL=http://localhost:4000
