# ============================
# 🌍 Environment & App Config
# ============================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# ============================
# 🔒 Authentication
# ============================
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d
JWT_ISSUER=foodhub-system

# ============================
# 🍃 MongoDB Connection
# ============================
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority
MONGO_DB=RestaurantDB

# ============================
# ⚡ CORS Allowed Origins
# ============================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000

# ============================
# 🧩 Rate Limit Config
# ============================
RL_GLOBAL_MAX=200
RL_GLOBAL_WINDOW=1 minute
RL_AUTH_MAX=12
RL_AUTH_WINDOW=1 minute
RL_BAN=0
# RL_REDIS_URL=redis://localhost:6379

# ============================
# 🧠 GraphQL
# ============================
GRAPHQL_GRAPHIQL=true
GRAPHQL_INTROSPECTION=true

# ============================
# 🔐 Security Feature Flags
# ============================
ENABLE_RECAPTCHA=false
RECAPTCHA_SECRET=your_recaptcha_secret

ENABLE_EMAIL_VERIFICATION=true
APP_PUBLIC_URL=http://localhost:5173

ENABLE_PASSWORD_POLICY=true

# ============================
# ✉️ Mail (nếu dùng xác thực email)
# ============================
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password
MAIL_FROM="FoodHub <no-reply@foodhub.local>"

UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/avif
UPLOAD_TO_WEBP=true
PUBLIC_BASE_URL=http://localhost:4000

# ============================
# 💳 Payment Providers
# ============================
PUBLIC_BASE_URL=http://localhost:4000

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PARTNER_NAME=Cohan Restaurant
MOMO_STORE_ID=cohan-store
MOMO_REQUEST_TYPE=captureWallet
MOMO_ENDPOINT_SANDBOX=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_ENDPOINT_PRODUCTION=https://payment.momo.vn/v2/gateway/api/create

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_ORDER_TYPE=other
VNPAY_URL_SANDBOX=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_URL_PRODUCTION=https://pay.vnpay.vn/vpcpay.html
