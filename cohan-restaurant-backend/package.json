{
  "name": "cohan-restaurant-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node --es-module-specifier-resolution=node src/server/server.js",
    "dev": "nodemon --es-module-specifier-resolution=node src/server/server.js",
    "test": "vitest run --testTimeout=30000",
    "test:serial": "vitest run --testTimeout=30000 --maxWorkers=1",
    "test:menu-rbac": "vitest run tests/server/auth-user-resolver.test.js tests/resolvers/menu-permission.test.js tests/resolvers/menu-audit-log-permission.test.js",
    "seed:admin": "node scripts/seed-admin.js",
    "import:restaurant-data": "node scripts/import-restaurant-data.js",
    "test:db": "node scripts/test-db.js",
    "seed:demo:stock": "node scripts/seed-demo-ingredient-stock.js",
    "seed:availability:2026-05-25": "node scripts/seed-availability-week-2026-05-25.js",
    "sync:menuitem-category-json": "node scripts/update-menuitem-category-from-db-json.js --dry-run",
    "lint": "node --check src/server/server.js",
    "build": "node -e \"console.log('Backend build step: no transpilation required.')\"",
    "test:watch": "vitest",
    "check:user-email": "node scripts/check-user-by-email.js",
    "seed:demo:scheduling": "node scripts/seedSchedulingAttendanceDemo.js",
    "verify:demo:performance": "node scripts/verifyStaffPerformanceDemoRegression.js",
    "repair:demo:operator-account-types": "node scripts/repairDemoOperatorAccountTypes.js",
    "seed:demo:staff-performance": "npm run repair:demo:operator-account-types && node scripts/seedStaffPerformanceDemo.js",
    "verify:demo:staff-performance-data": "node scripts/verifyStaffPerformanceDemoData.js",
    "seed:permissions": "node scripts/seedPermissions.js",
    "seed:parent-roles": "node scripts/seedParentRoles.js",
    "seed:roles": "node scripts/seedRoles.js",
    "seed:rbac": "npm run seed:permissions && npm run seed:parent-roles && npm run seed:roles",
    "seed:demo:coupon-promotion": "node scripts/seedCouponPromotionDemo.js",
    "seed:demo:promotion-management": "node scripts/seedPromotionManagementDemo.js --restaurantId=69ce9e2e8d8d711f12e251b1",
    "seed:demo:menu-management": "node scripts/seedMenuManagementDemo.js",
    "seed:demo:customers": "node scripts/seedCustomerDemoData.js --restaurantId=69ce9e2e8d8d711f12e251b1",
    "test:performance": "vitest run tests/services/staff-performance-core-formula.service.test.js tests/services/performance-incident.service.test.js tests/services/performance-appeal.service.test.js",
    "backfill:restaurant-location": "node scripts/backfillRestaurantLocation.js",
    "seed:demo:payroll-readiness": "node scripts/seedPayrollReadinessDemo.js",
    "verify:demo:scheduling-attendance": "node scripts/verifySchedulingAttendanceDemoRegression.js",
    "seed:demo:combos": "node scripts/seedCombosDemo.js",
    "migrate:brand-memberships": "node scripts/migrate-restaurant-manager-to-brand-membership.js",
    "cleanup:brand-scope": "node scripts/migrate-restaurant-manager-to-brand-membership.js --apply --confirm-cleanup"
  },
